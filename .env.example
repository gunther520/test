# Optional. The tracker works without keys via public web search
# (DuckDuckGo + Google News RSS) and Reddit's public JSON API.
# Copy this file to .env.local and restart `npm run dev`.

# Gemini with Google Search grounding (preferred optional Google web search)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Official YouTube Data API v3 search
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Google Programmable Search Engine (optional; CSE JSON API must be enabled
# on the same Cloud project as the key)
# https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Brave Search API
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
